# ============================================
# STRATIGRAPH: Environment Variables Template
# ============================================
# 
# Bu dosyayı .env.local olarak kaydet ve 
# Supabase Admin Console''dan değerleri al.
#
# URL: https://app.supabase.com → Proje → Settings → API
# ============================================

# Supabase Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# Supabase Anon Key (Herkese açık, güvenli)
VITE_SUPABASE_ANON_KEY=eyJhbGc...YOUR_ANON_KEY_HERE...

# (İsteğe bağlı) Supabase Service Role Key 
# NOT: BU SADECE BACKEND''DE KULLAN! Frontend''de KEMADİ YÖKSELtİ
# VITE_SUPABASE_SERVICE_ROLE=eyJhbGc...YOUR_SERVICE_ROLE_KEY...

# (İsteğe bağlı) API Base URL
# VITE_API_BASE_URL=http://localhost:3000

# (İsteğe bağlı) Environment
VITE_ENV=development

# ============================================
# NOT: .env.local dosyası git''e EKLEME
# Add to .gitignore:
# .env.local
# .env.*.local
# ============================================
